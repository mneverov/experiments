    {
      "id": 8,
      "type": "timeseries",
      "title": "GC cycles (all, incl. periodic), forced GCs and FreeOSMemory calls",
      "description": "Without allocation, GC runs only when sysmon triggers the periodic GC every 2 min (counted as a normal cycle, not as forced). debug.FreeOSMemory is a forced GC plus a full scavenge.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
