{
  "uid": "memtest",
  "title": "memtest: does Go return RAM to the OS?",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "pod",
        "type": "query",
        "label": "pod",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(memtest_info{namespace=\"memtest\"}, pod)",
          "refId": "pod"
        },
        "definition": "label_values(memtest_info{namespace=\"memtest\"}, pod)"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "phase change",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "changes(memtest_phase{namespace=\"memtest\"}[10s]) > 0",
        "step": "5s",
        "titleFormat": "phase change {{pod}}",
        "textFormat": "{{pod}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Experiment",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory the app holds on purpose",
      "description": "memtest_held_bytes: base, base+spike during the spike, base again after it. Annotations mark phase changes.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "min",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "memtest_held_bytes{namespace=\"memtest\"} * on(pod) group_left(experiment, gomemlimit) memtest_info",
          "legendFormat": "{{pod}} ({{experiment}})"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Restarts and OOM kills",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "min",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_status_restarts_total{namespace=\"memtest\"}",
          "legendFormat": "restarts {{pod}}"
        },
        {
          "refId": "B",
          "expr": "kube_pod_container_status_last_terminated_reason{namespace=\"memtest\", reason=\"OOMKilled\"}",
          "legendFormat": "last terminated OOMKilled {{pod}}"
        },
        {
          "refId": "C",
          "expr": "sum by (pod) (container_oom_events_total{namespace=\"memtest\", container=\"memtest\"})",
          "legendFormat": "cgroup oom events {{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Inside the pod: Go runtime (runtime/metrics) and kernel view of the process (smaps, cgroup)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Go heap: $pod",
      "description": "Stacked heap memory classes. 'free, retained' is what the runtime keeps for reuse; the kernel cannot take it back (no swap). 'released' was handed back with MADV_DONTNEED (default) or MADV_FREE (GODEBUG=madvdontneed=0).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "heap goal"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "total mapped by runtime"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GOMEMLIMIT"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "min",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_memory_classes_heap_objects_bytes{pod=~\"$pod\"}",
          "legendFormat": "objects (live + not yet swept)"
        },
        {
          "refId": "B",
          "expr": "go_memory_classes_heap_unused_bytes{pod=~\"$pod\"}",
          "legendFormat": "unused (fragmentation in spans)"
        },
        {
          "refId": "C",
          "expr": "go_memory_classes_heap_free_bytes{pod=~\"$pod\"}",
          "legendFormat": "free, retained (dirty, NOT returned to OS)"
        },
        {
          "refId": "D",
          "expr": "go_memory_classes_heap_released_bytes{pod=~\"$pod\"}",
          "legendFormat": "released to OS (madvise)"
        },
        {
          "refId": "E",
          "expr": "go_gc_heap_goal_bytes{pod=~\"$pod\"}",
          "legendFormat": "heap goal"
        },
        {
          "refId": "F",
          "expr": "go_gc_gomemlimit_bytes{pod=~\"$pod\"} < 1e15",
          "legendFormat": "GOMEMLIMIT"
        },
        {
          "refId": "G",
          "expr": "go_memory_classes_total_bytes{pod=~\"$pod\"}",
          "legendFormat": "total mapped by runtime"
        }
      ],
      "repeat": "pod",
      "repeatDirection": "h",
      "maxPerRow": 2
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kernel view: $pod",
      "description": "What the kernel charges to the process and its container. With MADV_FREE, RSS stays high and LazyFree grows until the kernel needs the pages.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "container limit (memory.max)"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "min",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "memtest_smaps_rollup_bytes{pod=~\"$pod\", field=\"Rss\"}",
          "legendFormat": "RSS (smaps)"
        },
        {
          "refId": "B",
          "expr": "memtest_smaps_rollup_bytes{pod=~\"$pod\", field=\"Private_Dirty\"}",
          "legendFormat": "private dirty"
        },
        {
          "refId": "C",
          "expr": "memtest_smaps_rollup_bytes{pod=~\"$pod\", field=\"LazyFree\"}",
          "legendFormat": "LazyFree (MADV_FREE'd, still in RSS)"
        },
        {
          "refId": "D",
          "expr": "memtest_smaps_rollup_bytes{pod=~\"$pod\", field=\"Swap\"}",
          "legendFormat": "swapped"
        },
        {
          "refId": "E",
          "expr": "memtest_cgroup_memory_bytes{pod=~\"$pod\", file=\"current\"}",
          "legendFormat": "cgroup memory.current"
        },
        {
          "refId": "F",
          "expr": "memtest_cgroup_memory_stat{pod=~\"$pod\", field=\"anon\"}",
          "legendFormat": "cgroup anon"
        },
        {
          "refId": "G",
          "expr": "memtest_cgroup_memory_stat{pod=~\"$pod\", field=\"file\"}",
          "legendFormat": "cgroup file"
        },
        {
          "refId": "H",
          "expr": "memtest_cgroup_memory_bytes{pod=~\"$pod\", file=\"max\"}",
          "legendFormat": "container limit (memory.max)"
        }
      ],
      "repeat": "pod",
      "repeatDirection": "h",
      "maxPerRow": 2
    },
