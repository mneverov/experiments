    {
      "id": 10,
      "type": "timeseries",
      "title": "Kernel reclaim in the pod cgroup (pages/s)",
      "description": "pglazyfree: pages the app marked MADV_FREE. pglazyfreed: of those, pages the kernel actually took back under pressure. pgscan/pgsteal: reclaim scanning/stealing.",
